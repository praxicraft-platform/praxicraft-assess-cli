{
  "name": "@praxicraft/assess-cli",
  "version": "2.0.6",
  "description": "Official Praxicraft Assess CLI — interactive TUI, Ask AI, and Public API commands.",
  "type": "module",
  "bin": {
    "praxicraft-assess": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun run scripts/build.ts",
    "fetch-cross-deps": "bun run scripts/fetch-cross-deps.ts",
    "build-native": "bun run scripts/build-binaries.ts",
    "test": "bun test",
    "start": "bun src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praxicraft-platform/praxicraft-assess-cli.git"
  },
  "bugs": {
    "url": "https://github.com/praxicraft-platform/praxicraft-assess-cli/issues"
  },
  "homepage": "https://docs.praxicraft.com/sdks/cli",
  "keywords": [
    "praxicraft",
    "assess",
    "cli",
    "hiring",
    "tui",
    "mcp",
    "opentui",
    "bun"
  ],
  "author": "Praxicraft",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.36",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "0.2.3",
    "@opentui/solid": "0.2.3",
    "ai": "^6.0.168",
    "solid-js": "^1.9.12"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.2.3",
    "@opentui/core-darwin-x64": "0.2.3",
    "@opentui/core-linux-arm64": "0.2.3",
    "@opentui/core-linux-x64": "0.2.3",
    "@opentui/core-win32-x64": "0.2.3",
    "@praxicraft/assess-mcp": "^0.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
